{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/gitflow-hooks/gitflow-guard.py\" # gitflow-hooks",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/gitflow-hooks/gitflow-stop-check.py\" # gitflow-hooks",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
